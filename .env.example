# 复制成 .env 后填写：cp .env.example .env
# MinerU 官方 key，多个用逗号分隔；留空也可以启动，之后在 Web 设置页里粘贴。
# 注意：.env 不要提交到仓库（已在 .gitignore 里忽略它，见仓库根目录的 .gitignore）。
SAG_MINERU_API_KEYS=

# 对外端口（默认 8005；容器内服务仍监听 3001）
PORT=8005

# HuggingFace 下载源（仅构建 Docling 基础镜像时使用）
HF_ENDPOINT=https://hf-mirror.net

# 国内构建源：Rust crates、Python 依赖与 Python standalone 运行时
SAG_CARGO_REGISTRY_MIRROR=sparse+https://rsproxy.cn/index/
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_PYTHON_INSTALL_MIRROR=https://registry.npmmirror.com/-/binary/python-build-standalone
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
SAG_TORCH_CPU_INDEX_URL=https://mirror.sjtu.edu.cn/pytorch-wheels/cpu

# Docling 依赖基础镜像：仅当 Docling 安装流程或依赖升级时更换标签并重建
SAG_RUNTIME_BASE_IMAGE=sag-parse-server-base:a801f28
